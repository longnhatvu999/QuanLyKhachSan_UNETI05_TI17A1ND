@model QuanLyKhachSan_UNETI05_TI17A1ND.Models.PhieuDatPhong
@{
    ViewData["Title"] = "Chi tiết phiếu đặt phòng";
    var vaiTro = Context.Session.GetString("VaiTro");
    var laAdmin = vaiTro == "Admin";
    decimal tongTien = Model.ChiTietDatPhongs?.Sum(ct => ct.ThanhTien) ?? 0;
}

<h2><i class="bi bi-file-earmark-text"></i> Chi tiết phiếu #@Model.MaPhieuDat</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-light">Thông tin khách hàng</div>
            <div class="card-body">
                <p><strong>Họ tên:</strong> @Model.KhachHang?.HoTen</p>
                <p><strong>SĐT:</strong> @Model.KhachHang?.SoDienThoai</p>
                <p><strong>Email:</strong> @Model.KhachHang?.Email</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-light">Thông tin đặt phòng</div>
            <div class="card-body">
                <p><strong>Ngày đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Ngày nhận dự kiến:</strong> @Model.NgayNhanDuKien.ToString("dd/MM/yyyy")</p>
                <p><strong>Ngày trả dự kiến:</strong> @Model.NgayTraDuKien.ToString("dd/MM/yyyy")</p>
                <p>
                    <strong>Trạng thái:</strong>
                    @switch (Model.TrangThai)
                    {
                        case "Chờ xác nhận": <span class="badge bg-warning text-dark">Chờ xác nhận</span> break;
                        case "Đã xác nhận": <span class="badge bg-info text-dark">Đã xác nhận</span> break;
                        case "Đã nhận phòng": <span class="badge bg-primary">Đã nhận phòng</span> break;
                        case "Đã trả phòng": <span class="badge bg-success">Đã trả phòng</span> break;
                        case "Đã hủy": <span class="badge bg-secondary">Đã hủy</span> break;
                    }
                </p>
            </div>
        </div>
    </div>
</div>

<h4>Chi tiết phòng đặt</h4>
<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Số phòng</th>
            <th>Loại phòng</th>
            <th class="text-end">Đơn giá đêm</th>
            <th class="text-center">Số đêm</th>
            <th class="text-end">Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ChiTietDatPhongs != null)
        {
            foreach (var ct in Model.ChiTietDatPhongs)
            {
                <tr>
                    <td>@ct.Phong?.SoPhong</td>
                    <td>@ct.Phong?.LoaiPhong?.TenLoaiPhong</td>
                    <td class="text-end">@ct.DonGiaDem.ToString("N0") VNĐ</td>
                    <td class="text-center">@ct.SoDem</td>
                    <td class="text-end">@ct.ThanhTien.ToString("N0") VNĐ</td>
                </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="4" class="text-end">Tổng tiền dự kiến:</th>
            <th class="text-end text-danger">@tongTien.ToString("N0") VNĐ</th>
        </tr>
    </tfoot>
</table>

<div class="mt-3">
    <a asp-action="@(laAdmin ? "Index" : "CuaToi")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>

    @* ========== NÚT THAO TÁC CHO ADMIN ========== *@
    @if (laAdmin)
    {
        @if (Model.TrangThai == "Chờ xác nhận")
        {
            <form asp-action="XacNhanDatPhong" asp-route-id="@Model.MaPhieuDat" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('Xác nhận phiếu đặt phòng này?');">
                    <i class="bi bi-check-circle"></i> Xác nhận đặt phòng
                </button>
            </form>
        }

        @if (Model.TrangThai == "Đã xác nhận")
        {
            <form asp-action="XacNhanNhanPhong" asp-route-id="@Model.MaPhieuDat" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"
                        onclick="return confirm('Xác nhận khách đã nhận phòng?');">
                    <i class="bi bi-box-arrow-in-right"></i> Xác nhận nhận phòng
                </button>
            </form>
        }

        @if (Model.TrangThai == "Đã nhận phòng")
        {
            <form asp-action="XacNhanTraPhong" asp-route-id="@Model.MaPhieuDat" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning"
                        onclick="return confirm('Xác nhận khách đã trả phòng?');">
                    <i class="bi bi-box-arrow-right"></i> Xác nhận trả phòng
                </button>
            </form>
        }

        @if (Model.TrangThai == "Chờ xác nhận" || Model.TrangThai == "Đã xác nhận")
        {
            <form asp-action="HuyPhieu" asp-route-id="@Model.MaPhieuDat" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Bạn có chắc chắn muốn hủy phiếu này?');">
                    <i class="bi bi-x-circle"></i> Hủy phiếu
                </button>
            </form>
        }
    }

    @* ========== NÚT HỦY CHO KHÁCH HÀNG (chỉ khi Chờ xác nhận) ========== *@
    @if (!laAdmin && Model.TrangThai == "Chờ xác nhận")
    {
        <form asp-action="HuyPhieu" asp-route-id="@Model.MaPhieuDat" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"
                    onclick="return confirm('Bạn có chắc chắn muốn hủy phiếu này?');">
                <i class="bi bi-x-circle"></i> Hủy phiếu
            </button>
        </form>
    }
</div>