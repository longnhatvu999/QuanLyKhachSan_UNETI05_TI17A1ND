
@model QuanLyKhachSan_UNETI05_TI17A1ND.Models.KhachHang

@{
    ViewData["Title"] = "Sửa thông tin khách hàng";
    var vaiTro = Context.Session.GetString("VaiTro");
    var laAdmin = vaiTro == "Admin";
    var ngayToiDa = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");
}

<div class="container mt-4">
    <h2 class="mb-4">Sửa thông tin khách hàng</h2>

    <form asp-action="@(laAdmin ? "Sua" : "SuaThongTin")"
          asp-route-id="@Model.MaKhachHang"
          method="post"
          id="formSuaThongTin">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <input type="hidden" asp-for="MaKhachHang" />
        <input type="hidden" asp-for="MaTaiKhoan" />
        <input type="hidden" asp-for="NgayDangKy" />
        <input type="hidden" asp-for="TrangThai" />

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label">Họ và tên</label>
            <input asp-for="HoTen" class="form-control" required />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
            <input asp-for="NgaySinh"
                   type="date"
                   class="form-control"
                   id="NgaySinh"
                   max="@ngayToiDa"
                   required />
            <span asp-validation-for="NgaySinh" class="text-danger"></span>
            <span id="loiNgaySinh" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GioiTinh" class="form-label">Giới tính</label>
            <select asp-for="GioiTinh" class="form-select" required>
                <option value="">-- Chọn giới tính --</option>
                <option value="Nam">Nam</option>
                <option value="Nữ">Nữ</option>
                <option value="Khác">Khác</option>
            </select>
            <span asp-validation-for="GioiTinh" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
            <input asp-for="SoDienThoai"
                   type="tel"
                   class="form-control"
                   id="SoDienThoai"
                   maxlength="10"
                   pattern="[0-9]{10}"
                   inputmode="numeric"
                   title="Số điện thoại phải gồm đúng 10 chữ số."
                   required />
            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            <span id="loiSoDienThoai" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CCCD" class="form-label">CCCD</label>
            <input asp-for="CCCD" class="form-control" />
            <span asp-validation-for="CCCD" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
            <textarea asp-for="DiaChi"
                      class="form-control"
                      rows="3"></textarea>
            <span asp-validation-for="DiaChi" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Lưu thay đổi
            </button>

            @if (laAdmin)
            {
                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại danh sách
                </a>
            }
            else
            {
                <a asp-action="ThongTinCaNhan" class="btn btn-secondary">
                    Quay lại
                </a>
            }
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const form = document.getElementById("formSuaThongTin");
        const soDienThoai = document.getElementById("SoDienThoai");
        const ngaySinh = document.getElementById("NgaySinh");

        const loiSoDienThoai = document.getElementById("loiSoDienThoai");
        const loiNgaySinh = document.getElementById("loiNgaySinh");

        function layNgayToiDa() {
            const homNay = new Date();
            const ngay = new Date(
                homNay.getFullYear() - 18,
                homNay.getMonth(),
                homNay.getDate()
            );

            const nam = ngay.getFullYear();
            const thang = String(ngay.getMonth() + 1).padStart(2, "0");
            const ngayTrongThang = String(ngay.getDate()).padStart(2, "0");

            return `${nam}-${thang}-${ngayTrongThang}`;
        }

        const ngayHopLeToiDa = layNgayToiDa();
        ngaySinh.max = ngayHopLeToiDa;

        soDienThoai.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, "").slice(0, 10);
            kiemTraSoDienThoai();
        });

        function kiemTraSoDienThoai() {
            if (!/^[0-9]{10}$/.test(soDienThoai.value)) {
                loiSoDienThoai.textContent =
                    "Số điện thoại phải gồm đúng 10 chữ số.";
                return false;
            }

            loiSoDienThoai.textContent = "";
            return true;
        }

        function kiemTraNgaySinh() {
            if (!ngaySinh.value) {
                loiNgaySinh.textContent = "Vui lòng nhập ngày sinh.";
                return false;
            }

            if (ngaySinh.value > ngayHopLeToiDa) {
                loiNgaySinh.textContent =
                    "Khách hàng phải đủ 18 tuổi trở lên.";
                return false;
            }

            loiNgaySinh.textContent = "";
            return true;
        }

        ngaySinh.addEventListener("change", kiemTraNgaySinh);

        form.addEventListener("submit", function (event) {
            const sdtHopLe = kiemTraSoDienThoai();
            const ngaySinhHopLe = kiemTraNgaySinh();

            if (!sdtHopLe || !ngaySinhHopLe) {
                event.preventDefault();
            }
        });
    </script>
}
