@model QuanLyKhachSan_UNETI05_TI17A1ND.ViewModels.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4><i class="bi bi-box-arrow-in-right"></i> Đăng nhập hệ thống</h4>
            </div>
            <div class="card-body">
                <form asp-action="DangNhap" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label"></label>
                        <input asp-for="TenDangNhap" class="form-control" autofocus />
                        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label"></label>
                        <input asp-for="MatKhau" class="form-control" />
                        <span asp-validation-for="MatKhau" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="GhiNho" class="form-check-input" />
                        <label asp-for="GhiNho" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                    </button>
                    <hr />
                    <div class="text-center">
                        <span class="text-muted">Chưa có tài khoản?</span>
                        <a asp-action="DangKy" class="text-decoration-none">
                            <strong>Đăng ký ngay</strong>
                        </a>
                    </div>
                </form>

                <hr />
                <div class="small text-muted">
                    <strong>Tài khoản mẫu:</strong><br />
                    - Admin: <code>admin / admin123</code><br />
                    - Khách hàng: <code>kh1 / 123456</code>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}