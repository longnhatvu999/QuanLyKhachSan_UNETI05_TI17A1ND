@model QuanLyKhachSan_UNETI05_TI17A1ND.ViewModels.DangKyViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white text-center">
                <h4><i class="bi bi-person-plus"></i> Đăng ký tài khoản khách hàng</h4>
            </div>
            <div class="card-body">
                <form asp-action="DangKy" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @* ===== PHẦN 1: THÔNG TIN TÀI KHOẢN ===== *@
                    <h5 class="text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-key"></i> Thông tin tài khoản
                    </h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TenDangNhap" class="form-label"></label>
                            <input asp-for="TenDangNhap" class="form-control" autofocus />
                            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MatKhau" class="form-label"></label>
                            <input asp-for="MatKhau" class="form-control" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="XacNhanMatKhau" class="form-label"></label>
                            <input asp-for="XacNhanMatKhau" class="form-control" />
                            <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                        </div>
                    </div>

                    @* ===== PHẦN 2: THÔNG TIN CÁ NHÂN ===== *@
                    <h5 class="text-primary border-bottom pb-2 mb-3 mt-3">
                        <i class="bi bi-person"></i> Thông tin cá nhân
                    </h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoTen" class="form-label"></label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                             <label asp-for="SoDienThoai" class="form-label"></label>
                                 <!-- Đã thêm các thuộc tính ép định dạng 10 số -->
                                     <input asp-for="SoDienThoai" 
                                            type="tel" 
                                            class="form-control" 
                                            maxlength="10" 
                                            pattern="[0-9]{10}" 
                                            title="Số điện thoại phải gồm đúng 10 chữ số." 
                                            inputmode="numeric" 
                                            required />
                                     <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                                 </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="NgaySinh" class="form-label"></label>
                            <input asp-for="NgaySinh" type="date" class="form-control" />
                            <span asp-validation-for="NgaySinh" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="GioiTinh" class="form-label"></label>
                            <select asp-for="GioiTinh" class="form-select">
                                <option value="">-- Chọn --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CCCD" class="form-label"></label>
                            <input asp-for="CCCD" class="form-control" />
                            <span asp-validation-for="CCCD" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label"></label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>

                    @* ===== NÚT ===== *@
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-person-plus"></i> Đăng ký
                        </button>
                        <a asp-action="DangNhap" class="btn btn-secondary">
                            <i class="bi bi-box-arrow-in-right"></i> Đã có tài khoản? Đăng nhập
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}