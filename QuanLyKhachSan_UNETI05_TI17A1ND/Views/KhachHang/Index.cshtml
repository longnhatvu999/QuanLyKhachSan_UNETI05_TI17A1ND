@model IEnumerable<QuanLyKhachSan_UNETI05_TI17A1ND.Models.KhachHang>
@{
    ViewData["Title"] = "Quản lý khách hàng";
    string? searchString = ViewBag.SearchString;
    bool? trangThai = ViewBag.TrangThai;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people"></i> Danh sách khách hàng</h2>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="searchString" value="@searchString"
               class="form-control" placeholder="Tìm theo Họ tên / SĐT / Email / CCCD..." />
    </div>
    <div class="col-md-3">
        <select name="trangThai" class="form-select">
            <option value="">-- Tất cả trạng thái --</option>
            @if (trangThai == true)  { <option value="true" selected>Hoạt động</option> <option value="false">Bị khóa</option> }
            else if (trangThai == false) { <option value="true">Hoạt động</option> <option value="false" selected>Bị khóa</option> }
            else { <option value="true">Hoạt động</option> <option value="false">Bị khóa</option> }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Tìm</button>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Xóa lọc</a>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã KH</th>
                <th>Họ tên</th>
                <th>SĐT</th>
                <th>Email</th>
                <th>CCCD</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kh in Model)
            {
                <tr>
                    <td>@kh.MaKhachHang</td>
                    <td>@kh.HoTen</td>
                    <td>@kh.SoDienThoai</td>
                    <td>@kh.Email</td>
                    <td>@kh.CCCD</td>
                    <td class="text-center">
                        @if (kh.TrangThai)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Bị khóa</span>
                        }
                    </td>
                    <td class="text-center text-nowrap">
                        <a asp-action="Details" asp-route-id="@kh.MaKhachHang" class="btn btn-sm btn-info" title="Chi tiết">
                            <i class="bi bi-eye"></i>
                        </a>
                        <form asp-action="ToggleTrangThai" asp-route-id="@kh.MaKhachHang" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(kh.TrangThai ? "btn-outline-danger" : "btn-outline-success")"
                                    onclick="return confirm('Bạn có chắc chắn thay đổi trạng thái khách hàng này?');">
                                <i class="bi @(kh.TrangThai ? "bi-lock" : "bi-unlock")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning text-center">
        <i class="bi bi-info-circle"></i> Không tìm thấy khách hàng nào.
    </div>
}