@{
    ViewData["Title"] = "Trang chủ";
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
}

<!-- Phần Banner chính -->
<div class="text-center mt-5 mb-5">
    <h1 class="display-4 fw-bold text-primary">
        <i class="bi bi-building"></i> Hệ Thống Quản Lý Khách Sạn
    </h1>
    <p class="lead text-muted mt-3">
        <i class="bi bi-mortarboard-fill"></i> Bài tập lớn - Nhóm 05 - Lớp TI17A1ND - UNETI
    </p>

    @if (hoTen != null)
    {
        <div class="alert alert-success d-inline-block mt-3 shadow-sm px-4 py-3 rounded-pill border-success">
            Xin chào, <strong class="fs-5">@hoTen</strong> 
            <span class="badge bg-success ms-2">@vaiTro</span>
            <br />
            <small class="text-muted mt-2 d-block"><i class="bi bi-emoji-smile"></i> Chúc bạn một ngày tốt lành!</small>
        </div>
    }
    else
    {
        <div class="mt-4">
            <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-primary btn-lg px-5 py-3 shadow rounded-pill fw-bold">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập ngay
            </a>
        </div>
    }
</div>

<!-- Phần 3 Thẻ Tính Năng -->
<div class="row mt-5 text-center g-4">
    <!-- Thẻ 1 -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 feature-card transition-hover">
            <div class="card-body p-4">
                <div class="icon-wrapper bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-door-closed fs-1"></i>
                </div>
                <h4 class="fw-bold">Đa dạng phòng</h4>
                <p class="text-muted mb-0">5 loại phòng: Standard, Superior, Deluxe, Suite, Family đáp ứng mọi nhu cầu.</p>
            </div>
        </div>
    </div>
    
    <!-- Thẻ 2 -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 feature-card transition-hover">
            <div class="card-body p-4">
                <div class="icon-wrapper bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-calendar-check fs-1"></i>
                </div>
                <h4 class="fw-bold">Đặt phòng dễ dàng</h4>
                <p class="text-muted mb-0">Đặt phòng trực tuyến nhanh chóng, hệ thống kiểm tra trùng lịch tự động.</p>
            </div>
        </div>
    </div>
    
    <!-- Thẻ 3 -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 feature-card transition-hover">
            <div class="card-body p-4">
                <div class="icon-wrapper bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-graph-up-arrow fs-1"></i>
                </div>
                <h4 class="fw-bold">Thống kê chi tiết</h4>
                <p class="text-muted mb-0">Báo cáo doanh thu theo tháng, thống kê lượt đặt theo từng loại phòng.</p>
            </div>
        </div>
    </div>
</div>

<!-- CSS Tùy chỉnh thêm để tạo hiệu ứng mượt mà -->
<style>
    /* Hiệu ứng khi di chuột vào thẻ */
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    /* Chỉnh lại font chữ cho đẹp hơn */
    .lead {
        font-size: 1.15rem;
        font-weight: 500;
    }
</style>