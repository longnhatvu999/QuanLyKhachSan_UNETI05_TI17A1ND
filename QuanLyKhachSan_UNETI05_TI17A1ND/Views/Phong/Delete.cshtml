@model QuanLyKhachSan_UNETI05_TI17A1ND.Models.Phong
@{
    ViewData["Title"] = "Xóa phòng";
}

<h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa phòng</h2>
<hr />

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa phòng <strong>@Model.SoPhong</strong> không?
</div>

<dl class="row">
    <dt class="col-sm-3">Số phòng</dt>
    <dd class="col-sm-9">@Model.SoPhong</dd>

    <dt class="col-sm-3">Loại phòng</dt>
    <dd class="col-sm-9">@Model.LoaiPhong?.TenLoaiPhong</dd>

    <dt class="col-sm-3">Tầng</dt>
    <dd class="col-sm-9">@Model.Tang</dd>

    <dt class="col-sm-3">Đơn giá đêm</dt>
    <dd class="col-sm-9">@Model.DonGiaDem.ToString("N0") VNĐ</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="MaPhong" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</form>