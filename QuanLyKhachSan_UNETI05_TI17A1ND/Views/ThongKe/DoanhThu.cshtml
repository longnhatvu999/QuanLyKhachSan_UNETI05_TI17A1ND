﻿@* ============================================================*@
@*// Họ và tên: Bùi HỒng Anh*@
@*// Mã sinh viên: 23203100057*@
@*// Nội dung thực hiện: ViewModel cho Dashboard*@
@*// Module: 4*@
@*// Lớp: TI17A1ND - Nhóm 05*@
@*// ============================================================﻿*@@{
ViewData["Title"] = "Thống kê";
var doanhThuTheoThang = ViewBag.DoanhThuTheoThang as List<QuanLyKhachSan_UNETI05_TI17A1ND.ViewModels.DoanhThuTheoThangViewModel>;
var luotDatTheoPhong = ViewBag.LuotDatTheoPhong as List<QuanLyKhachSan_UNETI05_TI17A1ND.ViewModels.LuotDatTheoPhongViewModel>;
var luotDatTheoLoaiPhong = ViewBag.LuotDatTheoLoaiPhong as IEnumerable<dynamic>;
var topKhachHang = ViewBag.TopKhachHang as List<QuanLyKhachSan_UNETI05_TI17A1ND.ViewModels.TopKhachHangViewModel>;
var phieuTheoTrangThai = ViewBag.PhieuTheoTrangThai as IEnumerable<dynamic>;
var phongTheoLoai = ViewBag.PhongTheoLoai as IEnumerable<dynamic>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-graph-up"></i> Thống kê chi tiết</h2>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Về Dashboard
    </a>
</div>

@* ============================================================ *@
@* 1. DOANH THU THEO THÁNG                                        *@
@* ============================================================ *@
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-cash-stack"></i> Doanh thu theo tháng (từ phiếu đã trả phòng)
    </div>
    <div class="card-body">
        @if (doanhThuTheoThang != null && doanhThuTheoThang.Any())
        {
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Tháng</th>
                        <th class="text-center">Năm</th>
                        <th class="text-center">Số hóa đơn</th>
                        <th class="text-end">Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in doanhThuTheoThang)
                    {
                        <tr>
                            <td class="text-center">@item.Thang</td>
                            <td class="text-center">@item.Nam</td>
                            <td class="text-center">@item.SoHoaDon</td>
                            <td class="text-end"><strong>@item.DoanhThu.ToString("N0") VNĐ</strong></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-warning">
                        <th colspan="3" class="text-end">Tổng cộng:</th>
                        <th class="text-end">@doanhThuTheoThang.Sum(x => x.DoanhThu).ToString("N0") VNĐ</th>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">Chưa có dữ liệu doanh thu.</p>
        }
    </div>
</div>

@* ============================================================ *@
@* 2. SỐ PHÒNG THEO LOẠI + SỐ PHIẾU THEO TRẠNG THÁI                *@
@* ============================================================ *@
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-success text-white">
                <i class="bi bi-tags"></i> Số phòng theo loại phòng
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Loại phòng</th><th class="text-center">Số phòng</th></tr>
                    </thead>
                    <tbody>
                        @if (phongTheoLoai != null)
                        {
                            foreach (var item in phongTheoLoai)
                            {
                                <tr>
                                    <td>@item.TenLoaiPhong</td>
                                    <td class="text-center">@item.SoPhong</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-info text-white">
                <i class="bi bi-pie-chart"></i> Số phiếu theo trạng thái
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Trạng thái</th><th class="text-center">Số lượng</th></tr>
                    </thead>
                    <tbody>
                        @if (phieuTheoTrangThai != null)
                        {
                            foreach (var item in phieuTheoTrangThai)
                            {
                                <tr>
                                    <td>@item.TrangThai</td>
                                    <td class="text-center">@item.SoLuong</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@* 3. LƯỢT ĐẶT THEO TỪNG PHÒNG                                     *@
@* ============================================================ *@
<div class="card mb-4">
    <div class="card-header bg-warning text-dark">
        <i class="bi bi-bar-chart"></i> Số lượt đặt theo từng phòng
    </div>
    <div class="card-body">
        @if (luotDatTheoPhong != null && luotDatTheoPhong.Any())
        {
            <table class="table table-bordered table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hạng</th>
                        <th>Số phòng</th>
                        <th>Loại phòng</th>
                        <th class="text-center">Số lượt đặt</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                    }
                    @foreach (var item in luotDatTheoPhong)
                    {
                        <tr>
                            <td class="text-center">@stt</td>
                            <td><strong>@item.SoPhong</strong></td>
                            <td>@item.TenLoaiPhong</td>
                            <td class="text-center">
                                <span class="badge bg-primary">@item.SoLuotDat lượt</span>
                            </td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">Chưa có dữ liệu.</p>
        }
    </div>
</div>

@* ============================================================ *@
@* 4. LƯỢT ĐẶT THEO LOẠI PHÒNG + LOẠI ĐẶT NHIỀU NHẤT              *@
@* ============================================================ *@
<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <i class="bi bi-trophy"></i> Lượt đặt theo loại phòng
    </div>
    <div class="card-body">
        @if (luotDatTheoLoaiPhong != null && luotDatTheoLoaiPhong.Any())
        {
            var max = luotDatTheoLoaiPhong.FirstOrDefault();
            @if (max != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-star-fill"></i>
                    Loại phòng được đặt <strong>nhiều nhất</strong>:
                    <strong>@max.TenLoaiPhong</strong> với <strong>@max.SoLuotDat</strong> lượt đặt.
                </div>
            }

            <table class="table table-bordered table-sm mb-0">
                <thead class="table-light">
                    <tr><th>Loại phòng</th><th class="text-center">Số lượt đặt</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in luotDatTheoLoaiPhong)
                    {
                        <tr>
                            <td>@item.TenLoaiPhong</td>
                            <td class="text-center"><span class="badge bg-info">@item.SoLuotDat</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">Chưa có dữ liệu.</p>
        }
    </div>
</div>

@* ============================================================ *@
@* 5. TOP KHÁCH HÀNG                                              *@
@* ============================================================ *@
<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <i class="bi bi-people-fill"></i> Top 10 khách hàng đặt nhiều nhất
    </div>
    <div class="card-body">
        @if (topKhachHang != null && topKhachHang.Any())
        {
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Hạng</th>
                        <th>Họ tên</th>
                        <th>SĐT</th>
                        <th class="text-center">Số lượt đặt</th>
                        <th class="text-end">Tổng chi tiêu</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int hang = 1;
                    }
                    @foreach (var item in topKhachHang)
                    {
                        <tr>
                            <td class="text-center">
                                @if (hang == 1)
                                {
                                    <span class="badge bg-warning text-dark">🥇 1</span>
                                }
                                else if (hang == 2)
                                {

                                    <span class="badge bg-secondary">🥈 2</span>
                                }
                                else if (hang == 3)
                                {

                                    <span class="badge bg-danger">🥉 3</span>
                                }
                                else
                                {

                                    @hang
                                }
                            </td>
                            <td>@item.HoTen</td>
                            <td>@item.SoDienThoai</td>
                            <td class="text-center">@item.SoLuotDat</td>
                            <td class="text-end">@item.TongChiTieu.ToString("N0") VNĐ</td>
                        </tr>
                        hang++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">Chưa có dữ liệu.</p>
        }
    </div>
</div>