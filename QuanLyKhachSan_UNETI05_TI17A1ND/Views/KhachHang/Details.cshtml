@model QuanLyKhachSan_UNETI05_TI17A1ND.Models.KhachHang
@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<h2><i class="bi bi-person"></i> Chi tiết khách hàng</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Mã khách hàng</dt>
    <dd class="col-sm-9">@Model.MaKhachHang</dd>

    <dt class="col-sm-3">Họ tên</dt>
    <dd class="col-sm-9">@Model.HoTen</dd>

    <dt class="col-sm-3">Ngày sinh</dt>
    <dd class="col-sm-9">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>

    <dt class="col-sm-3">Giới tính</dt>
    <dd class="col-sm-9">@(Model.GioiTinh ?? "Chưa cập nhật")</dd>

    <dt class="col-sm-3">Số điện thoại</dt>
    <dd class="col-sm-9">@Model.SoDienThoai</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">CCCD</dt>
    <dd class="col-sm-9">@(Model.CCCD ?? "Chưa cập nhật")</dd>

    <dt class="col-sm-3">Địa chỉ</dt>
    <dd class="col-sm-9">@(Model.DiaChi ?? "Chưa cập nhật")</dd>

    <dt class="col-sm-3">Ngày đăng ký</dt>
    <dd class="col-sm-9">@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">
        @if (Model.TrangThai)
        {
            <span class="badge bg-success">Hoạt động</span>
        }
        else
        {
            <span class="badge bg-danger">Bị khóa</span>
        }
    </dd>
</dl>

<h4 class="mt-4">Danh sách phiếu đặt phòng</h4>
@if (Model.PhieuDatPhongs != null && Model.PhieuDatPhongs.Any())
{
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Mã phiếu</th>
                <th>Ngày đặt</th>
                <th>Ngày nhận</th>
                <th>Ngày trả</th>
                <th class="text-end">Tổng tiền</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.PhieuDatPhongs.OrderByDescending(x => x.NgayDat))
            {
                <tr>
                    <td>
                        <a asp-controller="PhieuDatPhong" asp-action="Details" asp-route-id="@p.MaPhieuDat">
                            #@p.MaPhieuDat
                        </a>
                    </td>
                    <td>@p.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@p.NgayNhanDuKien.ToString("dd/MM/yyyy")</td>
                    <td>@p.NgayTraDuKien.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@p.TongTienDuKien.ToString("N0") VNĐ</td>
                    <td>@p.TrangThai</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Chưa có phiếu đặt phòng nào.</p>
}

<a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>