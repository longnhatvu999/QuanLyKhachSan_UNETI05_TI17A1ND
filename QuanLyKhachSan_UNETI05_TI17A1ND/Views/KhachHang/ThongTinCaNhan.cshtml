﻿@model QuanLyKhachSan_UNETI05_TI17A1ND.Models.KhachHang
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-circle"></i> Thông tin cá nhân</h2>
    <a asp-action="SuaThongTin" class="btn btn-warning">
        <i class="bi bi-pencil"></i> Sửa thông tin
    </a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@Model.HoTen</dd>

            <dt class="col-sm-3">Ngày sinh</dt>
            <dd class="col-sm-9">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>

            <dt class="col-sm-3">Giới tính</dt>
            <dd class="col-sm-9">@(Model.GioiTinh ?? "Chưa cập nhật")</dd>

            <dt class="col-sm-3">Số điện thoại</dt>
            <dd class="col-sm-9">@Model.SoDienThoai</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">CCCD</dt>
            <dd class="col-sm-9">@(Model.CCCD ?? "Chưa cập nhật")</dd>

            <dt class="col-sm-3">Địa chỉ</dt>
            <dd class="col-sm-9">@(Model.DiaChi ?? "Chưa cập nhật")</dd>

            <dt class="col-sm-3">Ngày đăng ký</dt>
            <dd class="col-sm-9">@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>