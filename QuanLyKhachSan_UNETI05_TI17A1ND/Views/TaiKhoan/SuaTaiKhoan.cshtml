@model QuanLyKhachSan_UNETI05_TI17A1ND.Models.TaiKhoan
@{
    ViewData["Title"] = "Cập nhật Tài khoản";
}

<div class="container mt-4">
    <h3>Cập nhật thông tin Tài khoản</h3>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <!-- Lưu ý: asp-action phải là SuaTaiKhoan -->
            <form asp-action="SuaTaiKhoan" method="post">
                <!-- Truyền ID ẩn -->
                <input type="hidden" name="id" value="@Model.MaTaiKhoan" />
                
                <div class="mb-3">
                    <label class="form-label">Tên đăng nhập (Không được sửa):</label>
                    <input class="form-control" value="@Model.TenDangNhap" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Họ tên:</label>
                    <!-- Thêm name="hoTen" để Controller nhận được -->
                    <input name="hoTen" class="form-control" value="@Model.HoTen" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email:</label>
                    <!-- Thêm name="email" để Controller nhận được -->
                    <input name="email" type="email" class="form-control" value="@Model.Email" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Vai trò:</label>
                    <select name="vaiTroMoi" class="form-select">
                        <option value="Admin" selected="@(Model.VaiTro == "Admin")">Quản trị viên (Admin)</option>
                        <option value="KhachHang" selected="@(Model.VaiTro == "KhachHang")">Khách hàng</option>
                    </select>
                </div>

                <div class="mb-3 form-check">
                    <!-- Thêm checkbox trạng thái -->
                    <input type="checkbox" name="trangThai" value="true" class="form-check-input" id="trangThai" @(Model.TrangThai ? "checked" : "") />
                    <label class="form-check-label" for="trangThai">Tài khoản đang hoạt động (Bỏ tick để Khóa)</label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="DanhSachTaiKhoan" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>