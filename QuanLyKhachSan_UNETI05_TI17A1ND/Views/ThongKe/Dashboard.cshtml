@model QuanLyKhachSan_UNETI05_TI17A1ND.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-speedometer2"></i> Dashboard Quản Trị</h2>
    <a asp-action="DoanhThu" class="btn btn-outline-primary">
        <i class="bi bi-graph-up"></i> Xem thống kê chi tiết
    </a>
</div>

@* ============================================================ *@
@* KHỐI 1: SỐ LIỆU TỔNG QUÁT                                        *@
@* ============================================================ *@
<h5 class="text-secondary">Số liệu tổng quát</h5>
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white shadow h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small">Loại phòng</div>
                        <div class="h2 mb-0">@Model.TongLoaiPhong</div>
                    </div>
                    <i class="bi bi-tags display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white shadow h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small">Tổng phòng</div>
                        <div class="h2 mb-0">@Model.TongPhong</div>
                    </div>
                    <i class="bi bi-door-closed display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-warning text-dark shadow h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small">Khách hàng</div>
                        <div class="h2 mb-0">@Model.TongKhachHang</div>
                    </div>
                    <i class="bi bi-people display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-info text-white shadow h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small">Tổng phiếu đặt</div>
                        <div class="h2 mb-0">@Model.TongPhieuDat</div>
                    </div>
                    <i class="bi bi-file-earmark-text display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@* KHỐI 2: PHIẾU THEO TRẠNG THÁI                                    *@
@* ============================================================ *@
<h5 class="text-secondary">Phiếu đặt phòng theo trạng thái</h5>
<div class="row mb-4">
    <div class="col-md mb-3">
        <div class="card border-warning h-100">
            <div class="card-body text-center">
                <div class="h2 text-warning mb-0">@Model.PhieuChoXacNhan</div>
                <div class="small text-muted">Chờ xác nhận</div>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="card border-info h-100">
            <div class="card-body text-center">
                <div class="h2 text-info mb-0">@Model.PhieuDaXacNhan</div>
                <div class="small text-muted">Đã xác nhận</div>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="card border-primary h-100">
            <div class="card-body text-center">
                <div class="h2 text-primary mb-0">@Model.PhieuDaNhanPhong</div>
                <div class="small text-muted">Đã nhận phòng</div>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="card border-success h-100">
            <div class="card-body text-center">
                <div class="h2 text-success mb-0">@Model.PhieuDaTraPhong</div>
                <div class="small text-muted">Đã trả phòng</div>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="card border-secondary h-100">
            <div class="card-body text-center">
                <div class="h2 text-secondary mb-0">@Model.PhieuDaHuy</div>
                <div class="small text-muted">Đã hủy</div>
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@* KHỐI 3: PHÒNG THEO TRẠNG THÁI + DOANH THU                       *@
@* ============================================================ *@
<div class="row mb-4">
    <div class="col-md-8">
        <h5 class="text-secondary">Phòng theo trạng thái</h5>
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="card border-success h-100">
                    <div class="card-body text-center">
                        <div class="h2 text-success mb-0">@Model.PhongSanSang</div>
                        <div class="small text-muted">Sẵn sàng</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card border-warning h-100">
                    <div class="card-body text-center">
                        <div class="h2 text-warning mb-0">@Model.PhongDangSuDung</div>
                        <div class="small text-muted">Đang sử dụng</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card border-secondary h-100">
                    <div class="card-body text-center">
                        <div class="h2 text-secondary mb-0">@Model.PhongTamNgung</div>
                        <div class="small text-muted">Tạm ngừng</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <h5 class="text-secondary">Doanh thu</h5>
        <div class="card bg-gradient bg-success text-white h-100">
            <div class="card-body d-flex flex-column justify-content-center text-center">
                <i class="bi bi-cash-coin display-3 opacity-50"></i>
                <div class="small text-uppercase mt-2">Tổng doanh thu (từ phiếu đã trả)</div>
                <div class="h3 mb-0">@Model.TongDoanhThu.ToString("N0") VNĐ</div>
            </div>
        </div>
    </div>
</div>