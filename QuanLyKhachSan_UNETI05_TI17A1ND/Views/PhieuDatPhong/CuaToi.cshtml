﻿@model IEnumerable<QuanLyKhachSan_UNETI05_TI17A1ND.Models.PhieuDatPhong>
@{
    ViewData["Title"] = "Phiếu đặt phòng của tôi";
    string? trangThai = ViewBag.TrangThai;
    var dsTrangThai = ViewBag.DanhSachTrangThai as string[] ?? Array.Empty<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-file-earmark-text"></i> Phiếu đặt phòng của tôi</h2>
    <a asp-action="LichSuLuuTru" class="btn btn-outline-primary">
        <i class="bi bi-clock-history"></i> Lịch sử lưu trú
    </a>
</div>

<form asp-action="CuaToi" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="trangThai" class="form-select">
            <option value="">-- Tất cả trạng thái --</option>
            @foreach (var tt in dsTrangThai)
            {
                <option value="@tt" selected="@(trangThai == tt)">@tt</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc</button>
        <a asp-action="CuaToi" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Xóa lọc</a>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã</th>
                <th>Ngày đặt</th>
                <th>Ngày nhận</th>
                <th>Ngày trả</th>
                <th class="text-end">Tổng tiền</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>#@p.MaPhieuDat</td>
                    <td>@p.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@p.NgayNhanDuKien.ToString("dd/MM/yyyy")</td>
                    <td>@p.NgayTraDuKien.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@p.TongTienDuKien.ToString("N0") VNĐ</td>
                    <td class="text-center">
                        @switch (p.TrangThai)
                        {
                            case "Chờ xác nhận": <span class="badge bg-warning text-dark">Chờ xác nhận</span> break;
                            case "Đã xác nhận": <span class="badge bg-info text-dark">Đã xác nhận</span> break;
                            case "Đã nhận phòng": <span class="badge bg-primary">Đã nhận phòng</span> break;
                            case "Đã trả phòng": <span class="badge bg-success">Đã trả phòng</span> break;
                            case "Đã hủy": <span class="badge bg-secondary">Đã hủy</span> break;
                        }
                    </td>
                    <td class="text-center text-nowrap">
                        <a asp-action="Details" asp-route-id="@p.MaPhieuDat" class="btn btn-sm btn-info">
                            <i class="bi bi-eye"></i> Xem
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> Bạn chưa có phiếu đặt phòng nào.
    </div>
}